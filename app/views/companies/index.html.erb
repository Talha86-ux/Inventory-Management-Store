<%if user_signed_in? %>
 <%#if current_user.role=="Admin" %>

  <h1 class="heading">Company Details</h1>
  <table class="table table-striped table-hover space">
    <thead class="thead-light">
    <th>Name</th>
    <th>Business Domain</th>
    <th>Assigned Manager</th>
    <th></th>
    </thead>
    <tbody>
    <%@companies.each do |c| %>
      <tr>


        <td><%=c.name %></td>
        <td><%=c.business_domain %></td>
        <% manager = c.assign_manager %>
        <% if manager.nil? %>
          <% manager_name= "Not Assigned" %>
          <td><%=manager_name %></td>
        <% else %>
          <%manager_name= User.find_by_id(manager) %>
          <td><%=manager_name&.name %></td>
        <% end %>
        <td><%= link_to 'delete',
                        { controller: "companies", action: "destroy", id: c.id },
                        data: { confirm: 'Are you sure?' },
                        method: :delete, class:"icon_color" %>
        </td>
    <%end %>
    </tr>
    </tbody>
  </table>
  <br>

    <%#else %>

 <%#end %>

<%end %>